<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_freight" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collaboration_freight">
    <bpmn:participant id="Participant_client" name="Грузоотправитель" />
    <bpmn:participant id="Participant_atp" name="Автотранспортное предприятие" processRef="Process_request" />
    <bpmn:participant id="Participant_epd" name="Оператор ЭПД" />
    <bpmn:messageFlow id="M_1" sourceRef="Participant_client" targetRef="Start" />
    <bpmn:messageFlow id="M_2" sourceRef="T_ask" targetRef="Participant_client" />
    <bpmn:messageFlow id="M_3" sourceRef="Participant_client" targetRef="E_info" />
    <bpmn:messageFlow id="M_4" sourceRef="T_refuse" targetRef="Participant_client" />
    <bpmn:messageFlow id="M_5" sourceRef="T_offer" targetRef="Participant_client" />
    <bpmn:messageFlow id="M_6" sourceRef="Participant_client" targetRef="E_answer" />
    <bpmn:messageFlow id="M_7" sourceRef="T_confirm" targetRef="Participant_client" />
    <bpmn:messageFlow id="M_8" sourceRef="T_epd" targetRef="Participant_epd" />
    <bpmn:textAnnotation id="Annotation_legend">
      <bpmn:text>Цветом выделены операции, которые берет на себя информационная система</bpmn:text>
    </bpmn:textAnnotation>
  </bpmn:collaboration>
  <bpmn:process id="Process_request" name="Обработка заявки на междугороднюю перевозку груза и планирование рейса" isExecutable="false">
    <bpmn:laneSet id="LaneSet_atp">
      <bpmn:lane id="Lane_dispatcher" name="Диспетчер">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_check_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_check</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_ask</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_info</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_time</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_vehicle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_vehicle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_driver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_driver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_refuse_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_refuse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_refused</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cost</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_approval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_approval_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_offer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E_answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_accepted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_task</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_epd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_split</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_confirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_planned</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_mechanic" name="Механик">
        <bpmn:flowNodeRef>T_state</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_head" name="Начальник отдела эксплуатации">
        <bpmn:flowNodeRef>T_approve</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_driver" name="Водитель">
        <bpmn:flowNodeRef>T_get_task</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_accounting" name="Бухгалтерия">
        <bpmn:flowNodeRef>T_accounting</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataObject id="DO_request_obj" />
    <bpmn:dataObjectReference id="DO_request" name="Заявка на перевозку" dataObjectRef="DO_request_obj" />
    <bpmn:dataObject id="DO_vehicles_obj" />
    <bpmn:dataObjectReference id="DO_vehicles" name="Сведения о состоянии автомобилей" dataObjectRef="DO_vehicles_obj" />
    <bpmn:dataObject id="DO_drivers_obj" />
    <bpmn:dataObjectReference id="DO_drivers" name="Сведения о водителях и допусках" dataObjectRef="DO_drivers_obj" />
    <bpmn:dataObject id="DO_tariffs_obj" />
    <bpmn:dataObjectReference id="DO_tariffs" name="Тарифы предприятия" dataObjectRef="DO_tariffs_obj" />
    <bpmn:dataObject id="DO_trip_obj" />
    <bpmn:dataObjectReference id="DO_trip" name="Рейсовое задание" dataObjectRef="DO_trip_obj" />
    <bpmn:startEvent id="Start" name="Заявка поступила">
      <bpmn:outgoing>F_1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_def" />
    </bpmn:startEvent>
    <bpmn:task id="T_register" name="Зарегистрировать заявку">
      <bpmn:incoming>F_1</bpmn:incoming>
      <bpmn:outgoing>F_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_1">
        <bpmn:targetRef>DO_request</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_check_merge">
      <bpmn:incoming>F_2</bpmn:incoming>
      <bpmn:incoming>F_7</bpmn:incoming>
      <bpmn:outgoing>F_3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_check" name="Проверить комплектность заявки">
      <bpmn:incoming>F_3</bpmn:incoming>
      <bpmn:outgoing>F_4</bpmn:outgoing>
      <bpmn:property id="T_check_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_2">
        <bpmn:sourceRef>DO_request</bpmn:sourceRef>
        <bpmn:targetRef>T_check_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_complete" name="Заявка заполнена полностью?">
      <bpmn:incoming>F_4</bpmn:incoming>
      <bpmn:outgoing>F_5</bpmn:outgoing>
      <bpmn:outgoing>F_8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_ask" name="Запросить недостающие сведения">
      <bpmn:incoming>F_5</bpmn:incoming>
      <bpmn:outgoing>F_6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="E_info" name="Сведения получены">
      <bpmn:incoming>F_6</bpmn:incoming>
      <bpmn:outgoing>F_7</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_info_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:task id="T_route" name="Определить маршрут и расстояние">
      <bpmn:incoming>F_8</bpmn:incoming>
      <bpmn:outgoing>F_9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_time" name="Рассчитать время в пути">
      <bpmn:incoming>F_9</bpmn:incoming>
      <bpmn:outgoing>F_10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_state" name="Сообщить о состоянии автомобилей">
      <bpmn:incoming>F_10</bpmn:incoming>
      <bpmn:outgoing>F_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_3">
        <bpmn:targetRef>DO_vehicles</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T_vehicle" name="Подобрать автомобиль">
      <bpmn:incoming>F_11</bpmn:incoming>
      <bpmn:outgoing>F_12</bpmn:outgoing>
      <bpmn:property id="T_vehicle_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_4">
        <bpmn:sourceRef>DO_vehicles</bpmn:sourceRef>
        <bpmn:targetRef>T_vehicle_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_vehicle" name="Автомобиль подобран?">
      <bpmn:incoming>F_12</bpmn:incoming>
      <bpmn:outgoing>F_13</bpmn:outgoing>
      <bpmn:outgoing>F_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_driver" name="Подобрать водителя">
      <bpmn:incoming>F_13</bpmn:incoming>
      <bpmn:outgoing>F_15</bpmn:outgoing>
      <bpmn:property id="T_driver_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_5">
        <bpmn:sourceRef>DO_drivers</bpmn:sourceRef>
        <bpmn:targetRef>T_driver_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_driver" name="Водитель подобран?">
      <bpmn:incoming>F_15</bpmn:incoming>
      <bpmn:outgoing>F_16</bpmn:outgoing>
      <bpmn:outgoing>F_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_refuse_merge">
      <bpmn:incoming>F_14</bpmn:incoming>
      <bpmn:incoming>F_16</bpmn:incoming>
      <bpmn:outgoing>F_17</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_refuse" name="Сообщить об отказе в перевозке">
      <bpmn:incoming>F_17</bpmn:incoming>
      <bpmn:outgoing>F_18</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_refused" name="Заявка отклонена">
      <bpmn:incoming>F_18</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_cost" name="Рассчитать стоимость перевозки">
      <bpmn:incoming>F_19</bpmn:incoming>
      <bpmn:outgoing>F_20</bpmn:outgoing>
      <bpmn:property id="T_cost_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_6">
        <bpmn:sourceRef>DO_tariffs</bpmn:sourceRef>
        <bpmn:targetRef>T_cost_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_approval" name="Требуется согласование стоимости?">
      <bpmn:incoming>F_20</bpmn:incoming>
      <bpmn:outgoing>F_21</bpmn:outgoing>
      <bpmn:outgoing>F_22</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_approve" name="Согласовать стоимость перевозки">
      <bpmn:incoming>F_21</bpmn:incoming>
      <bpmn:outgoing>F_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="G_approval_merge">
      <bpmn:incoming>F_22</bpmn:incoming>
      <bpmn:incoming>F_23</bpmn:incoming>
      <bpmn:outgoing>F_24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T_offer" name="Сообщить условия перевозки грузоотправителю">
      <bpmn:incoming>F_24</bpmn:incoming>
      <bpmn:outgoing>F_25</bpmn:outgoing>
    </bpmn:task>
    <bpmn:intermediateCatchEvent id="E_answer" name="Ответ клиента получен">
      <bpmn:incoming>F_25</bpmn:incoming>
      <bpmn:outgoing>F_26</bpmn:outgoing>
      <bpmn:messageEventDefinition id="E_answer_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="G_accepted" name="Условия подтверждены?">
      <bpmn:incoming>F_26</bpmn:incoming>
      <bpmn:outgoing>F_27</bpmn:outgoing>
      <bpmn:outgoing>F_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_declined" name="Условия не приняты">
      <bpmn:incoming>F_27</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T_task" name="Сформировать рейсовое задание">
      <bpmn:incoming>F_28</bpmn:incoming>
      <bpmn:outgoing>F_29</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA_7">
        <bpmn:targetRef>DO_trip</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:task id="T_epd" name="Подтвердить заявку в системе оператора ЭПД">
      <bpmn:incoming>F_29</bpmn:incoming>
      <bpmn:outgoing>F_30</bpmn:outgoing>
      <bpmn:property id="T_epd_prop" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DA_8">
        <bpmn:sourceRef>DO_trip</bpmn:sourceRef>
        <bpmn:targetRef>T_epd_prop</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:parallelGateway id="G_split">
      <bpmn:incoming>F_30</bpmn:incoming>
      <bpmn:outgoing>F_31</bpmn:outgoing>
      <bpmn:outgoing>F_32</bpmn:outgoing>
      <bpmn:outgoing>F_33</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="T_confirm" name="Отправить подтверждение грузоотправителю">
      <bpmn:incoming>F_31</bpmn:incoming>
      <bpmn:outgoing>F_34</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_get_task" name="Получить рейсовое задание">
      <bpmn:incoming>F_32</bpmn:incoming>
      <bpmn:outgoing>F_35</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T_accounting" name="Принять сведения о рейсе">
      <bpmn:incoming>F_33</bpmn:incoming>
      <bpmn:outgoing>F_36</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="G_join">
      <bpmn:incoming>F_34</bpmn:incoming>
      <bpmn:incoming>F_35</bpmn:incoming>
      <bpmn:incoming>F_36</bpmn:incoming>
      <bpmn:outgoing>F_37</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="End_planned" name="Рейс запланирован">
      <bpmn:incoming>F_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_1" sourceRef="Start" targetRef="T_register" />
    <bpmn:sequenceFlow id="F_2" sourceRef="T_register" targetRef="G_check_merge" />
    <bpmn:sequenceFlow id="F_3" sourceRef="G_check_merge" targetRef="T_check" />
    <bpmn:sequenceFlow id="F_4" sourceRef="T_check" targetRef="G_complete" />
    <bpmn:sequenceFlow id="F_5" name="нет" sourceRef="G_complete" targetRef="T_ask" />
    <bpmn:sequenceFlow id="F_6" sourceRef="T_ask" targetRef="E_info" />
    <bpmn:sequenceFlow id="F_7" sourceRef="E_info" targetRef="G_check_merge" />
    <bpmn:sequenceFlow id="F_8" name="да" sourceRef="G_complete" targetRef="T_route" />
    <bpmn:sequenceFlow id="F_9" sourceRef="T_route" targetRef="T_time" />
    <bpmn:sequenceFlow id="F_10" sourceRef="T_time" targetRef="T_state" />
    <bpmn:sequenceFlow id="F_11" sourceRef="T_state" targetRef="T_vehicle" />
    <bpmn:sequenceFlow id="F_12" sourceRef="T_vehicle" targetRef="G_vehicle" />
    <bpmn:sequenceFlow id="F_13" name="да" sourceRef="G_vehicle" targetRef="T_driver" />
    <bpmn:sequenceFlow id="F_14" name="нет" sourceRef="G_vehicle" targetRef="G_refuse_merge" />
    <bpmn:sequenceFlow id="F_15" sourceRef="T_driver" targetRef="G_driver" />
    <bpmn:sequenceFlow id="F_16" name="нет" sourceRef="G_driver" targetRef="G_refuse_merge" />
    <bpmn:sequenceFlow id="F_17" sourceRef="G_refuse_merge" targetRef="T_refuse" />
    <bpmn:sequenceFlow id="F_18" sourceRef="T_refuse" targetRef="End_refused" />
    <bpmn:sequenceFlow id="F_19" name="да" sourceRef="G_driver" targetRef="T_cost" />
    <bpmn:sequenceFlow id="F_20" sourceRef="T_cost" targetRef="G_approval" />
    <bpmn:sequenceFlow id="F_21" name="да" sourceRef="G_approval" targetRef="T_approve" />
    <bpmn:sequenceFlow id="F_22" name="нет" sourceRef="G_approval" targetRef="G_approval_merge" />
    <bpmn:sequenceFlow id="F_23" sourceRef="T_approve" targetRef="G_approval_merge" />
    <bpmn:sequenceFlow id="F_24" sourceRef="G_approval_merge" targetRef="T_offer" />
    <bpmn:sequenceFlow id="F_25" sourceRef="T_offer" targetRef="E_answer" />
    <bpmn:sequenceFlow id="F_26" sourceRef="E_answer" targetRef="G_accepted" />
    <bpmn:sequenceFlow id="F_27" name="нет" sourceRef="G_accepted" targetRef="End_declined" />
    <bpmn:sequenceFlow id="F_28" name="да" sourceRef="G_accepted" targetRef="T_task" />
    <bpmn:sequenceFlow id="F_29" sourceRef="T_task" targetRef="T_epd" />
    <bpmn:sequenceFlow id="F_30" sourceRef="T_epd" targetRef="G_split" />
    <bpmn:sequenceFlow id="F_31" sourceRef="G_split" targetRef="T_confirm" />
    <bpmn:sequenceFlow id="F_32" sourceRef="G_split" targetRef="T_get_task" />
    <bpmn:sequenceFlow id="F_33" sourceRef="G_split" targetRef="T_accounting" />
    <bpmn:sequenceFlow id="F_34" sourceRef="T_confirm" targetRef="G_join" />
    <bpmn:sequenceFlow id="F_35" sourceRef="T_get_task" targetRef="G_join" />
    <bpmn:sequenceFlow id="F_36" sourceRef="T_accounting" targetRef="G_join" />
    <bpmn:sequenceFlow id="F_37" sourceRef="G_join" targetRef="End_planned" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_freight">
    <bpmndi:BPMNPlane id="Plane_freight" bpmnElement="Collaboration_freight">
      <bpmndi:BPMNShape id="Participant_client_di" bpmnElement="Participant_client" isHorizontal="true">
        <dc:Bounds x="150" y="40" width="3020" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_atp_di" bpmnElement="Participant_atp" isHorizontal="true">
        <dc:Bounds x="150" y="140" width="3020" height="880" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_dispatcher_di" bpmnElement="Lane_dispatcher" isHorizontal="true">
        <dc:Bounds x="180" y="140" width="2990" height="400" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_mechanic_di" bpmnElement="Lane_mechanic" isHorizontal="true">
        <dc:Bounds x="180" y="540" width="2990" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_head_di" bpmnElement="Lane_head" isHorizontal="true">
        <dc:Bounds x="180" y="660" width="2990" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_driver_di" bpmnElement="Lane_driver" isHorizontal="true">
        <dc:Bounds x="180" y="780" width="2990" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_accounting_di" bpmnElement="Lane_accounting" isHorizontal="true">
        <dc:Bounds x="180" y="900" width="2990" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_epd_di" bpmnElement="Participant_epd" isHorizontal="true">
        <dc:Bounds x="150" y="1060" width="3020" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="222" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="185" y="393" width="110" height="28" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_register_di" bpmnElement="T_register" bioc:stroke="#1b5e20" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#1b5e20">
        <dc:Bounds x="290" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_check_merge_di" bpmnElement="G_check_merge" isMarkerVisible="true">
        <dc:Bounds x="445" y="345" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_check_di" bpmnElement="T_check" bioc:stroke="#1b5e20" bioc:fill="#c8e6c9" color:background-color="#c8e6c9" color:border-color="#1b5e20">
        <dc:Bounds x="500" y="330" width="120" height="80" />
      </bpmndi:BPMNShape>
